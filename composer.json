{
    "name": "silvaleal/rotyphp",
    "license": "MIT",
    "description": "is a minimalist, simple and efficient micro-ORM and Query Builder built in PHP",
    "version": "0.1.7",
    "autoload": {
        "psr-4": {
            "RotyPHP\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "silvaleal",
            "email": "me@silvaleal.dev"
        }
    ],
    "require": {
        "php": "^8.0",
        "silvaleal/rotyquery": "0.0.9"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "pestphp/pest": "^5.3"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
